{
  "name": "miku-project-skills",
  "version": "0.12.2",
  "private": true,
  "description": "Agent Skills for miku-project",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm test && npm run build:bundle:zip",
    "build:bundle": "node scripts/build-skill-bundle.mjs",
    "build:bundle:zip": "npm run build:bundle && node scripts/build-skill-bundle-zip.mjs",
    "build:full": "npm run build",
    "update:runtime": "sh scripts/update-miku-project-runtime.sh",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
