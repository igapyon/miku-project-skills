{
  "schema_version": 1,
  "default_policy": "cli-preferred",
  "allowed_policies": [
    "cli-only",
    "cli-preferred",
    "mcp-only",
    "mcp-preferred",
    "handoff-only"
  ],
  "strict_policies": [
    "cli-only",
    "mcp-only",
    "handoff-only"
  ],
  "precedence": [
    "user-request",
    "environment-policy",
    "skill-config",
    "repository-default"
  ],
  "precedence_scope": "Preference order after applying hard constraints from environment-policy.",
  "environment_constraints": {
    "cli-only": ["cli"],
    "mcp-only": ["mcp"],
    "handoff-only": []
  },
  "fallback_allowed": {
    "cli-only": false,
    "cli-preferred": true,
    "mcp-only": false,
    "mcp-preferred": true,
    "handoff-only": false
  }
}
